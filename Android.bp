package {
    default_applicable_licenses: ["external_python_markupsafe_license"],
}

license {
    name: "external_python_markupsafe_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-BSD",
    ],
    license_text: [
        "LICENSE.txt",
    ],
}

python_library_host {
    name: "py-markupsafe",
    srcs: [
        "markupsafe/**/*.py",
    ],
}

python_library_host {
    name: "markupsafe",
    srcs: [
        "markupsafe/**/*.py",
    ],
}
